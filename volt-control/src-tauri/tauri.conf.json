{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Volt Control",
  "version": "0.1.0",
  "identifier": "com.knia.voltcontrol",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Volt Control",
        "width": 858,
        "height": 400,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#121316"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}